<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Bus Dashboard</masterLabel>
    <description>A dashboard showing bus status and construction details.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="status" type="String" default="Under Construction"
                datasource="Active,Inactive,Under Construction" label="Bus Status"
                description="Current status of the bus" />
            <property name="busName" type="String" default="Campus Express - Route A"
                label="Bus Name" description="Name of the bus (Under Construction)" />
            <property name="isStaffAvailable" type="Boolean" default="false"
                label="Is Staff Available (Deprecated)" />
            <property name="driverStatus" type="String" default="Available"
                datasource="Available,Not Available" label="Driver Status" />
            <property name="damagedParts" type="String" default="" label="Damaged Parts"
                description="e.g. Engine, Left Headlight" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>