<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Registration_After_Close</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, &quot;Closed&quot;)</errorConditionFormula>
    <errorMessage>Registration is closed. Participants cannot register after registration closes.</errorMessage>
</ValidationRule>
