<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paid_Date_Required</fullName>
    <active>true</active>
    <description>Requires the Paid Date when Status is Paid.</description>
    <errorConditionFormula>AND(
    ISPICKVAL( Payment_Status__c , &quot;Paid&quot;),
     ISBLANK( Fine_Date__c )
)</errorConditionFormula>
    <errorDisplayField>Fine_Date__c</errorDisplayField>
    <errorMessage>Enter the Paid Date before marking the fine as Paid.</errorMessage>
</ValidationRule>
