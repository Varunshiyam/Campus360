<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Overdue_Days_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Prevents users from entering negative overdue days.</description>
    <errorConditionFormula>Overdue_Days__c  &lt; 0</errorConditionFormula>
    <errorDisplayField>Overdue_Days__c</errorDisplayField>
    <errorMessage>Overdue Days cannot be negative.</errorMessage>
</ValidationRule>
