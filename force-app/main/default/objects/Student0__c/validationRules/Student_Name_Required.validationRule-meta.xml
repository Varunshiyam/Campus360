<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Student_Name_Required</fullName>
    <active>true</active>
    <description>Student Name should not be blank.</description>
    <errorConditionFormula>ISBLANK( Name )</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Student Name cannot be blank.</errorMessage>
</ValidationRule>
