<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Official_Email</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(
CONTAINS(
Email__c,
&quot;@college.edu&quot;
)
)</errorConditionFormula>
    <errorMessage>Please enter a valid official college email ending with @college.edu.</errorMessage>
</ValidationRule>
