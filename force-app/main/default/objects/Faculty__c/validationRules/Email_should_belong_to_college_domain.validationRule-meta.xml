<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_should_belong_to_college_domain</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(
CONTAINS(
Email__c,
&quot;@college.edu&quot;
)
)</errorConditionFormula>
    <errorMessage>Use your official college email.</errorMessage>
</ValidationRule>
